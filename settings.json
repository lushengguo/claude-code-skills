{
  "permissions": {
    "allow": [
      "Bash(git *)",
      "Bash(cmake *)",
      "Bash(make *)",
      "Bash(ninja *)",
      "Bash(meson *)",
      "Bash(g++ *)",
      "Bash(gcc *)",
      "Bash(clang++ *)",
      "Bash(clang *)",
      "Bash(clang-tidy *)",
      "Bash(clang-format *)",
      "Bash(python *)",
      "Bash(python3 *)",
      "Bash(pip *)",
      "Bash(pip3 *)",
      "Bash(pytest *)",
      "Bash(unittest *)",
      "Bash(nosetests *)",
      "Bash(ctest *)",
      "Bash(cppcheck *)",
      "Bash(cpplint *)",
      "Bash(pylint *)",
      "Bash(flake8 *)",
      "Bash(black *)",
      "Bash(mypy *)",
      "Bash(vcpkg *)",
      "Bash(conan *)",
      "Bash(./*)",
      "Bash(bazel *)",
      "Write(/home/*/projects/**)",
      "Write(/Users/*/projects/**)",
      "Write(/mnt/*/projects/**)",
      "Write(/tmp/claude_sandbox/**)",
      "Read(**)"
    ],
    "deny": [
      "Bash(rm -rf /*)",
      "Bash(rm -rf /)",
      "Bash(rm -rf ~)",
      "Bash(rm -rf .)",
      "Bash(sudo *)",
      "Bash(chmod 777 *)",
      "Bash(> /dev/sda*)",
      "Bash(dd if=*)",
      "Bash(mkfs.*)",
      "Bash(curl * | sh)",
      "Bash(wget * -O- | sh)",
      "Write(/etc/**)",
      "Write(/bin/**)",
      "Write(/boot/**)",
      "Write(/dev/**)",
      "Write(/sys/**)",
      "Write(/proc/**)",
      "Write(/root/**)",
      "Write(~/.ssh/**)",
      "Write(~/.gnupg/**)"
    ],
    "defaultMode": "auto"
  },
  "enabledPlugins": {
    "clangd-lsp@claude-plugins-official": true
  },
  "theme": "dark",
  "skipWorkflowUsageWarning": true
}