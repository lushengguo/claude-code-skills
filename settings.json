{
  "permissions": {
    "allow": [
      "Bash(git *)",
      "Bash(cmake *)",
      "Bash(make *)",
      "Bash(ninja *)",
      "Bash(meson *)",
      "Bash(g++ *)",
      "Bash(gcc *)",
      "Bash(clang++ *)",
      "Bash(clang *)",
      "Bash(clang-tidy *)",
      "Bash(clang-format *)",
      "Bash(python *)",
      "Bash(python3 *)",
      "Bash(pip *)",
      "Bash(pip3 *)",
      "Bash(pytest *)",
      "Bash(unittest *)",
      "Bash(nosetests *)",
      "Bash(ctest *)",
      "Bash(cppcheck *)",
      "Bash(cpplint *)",
      "Bash(pylint *)",
      "Bash(flake8 *)",
      "Bash(black *)",
      "Bash(mypy *)",
      "Bash(vcpkg *)",
      "Bash(conan *)",
      "Bash(./*)",
      "Bash(bazel *)",
      "Edit(/home/*/projects/**)",
      "Edit(/Users/*/projects/**)",
      "Edit(/mnt/*/projects/**)",
      "Edit(/tmp/claude_sandbox/**)",
      "Read(**)"
    ],
    "deny": [
      "Bash(rm -rf /*)",
      "Bash(rm -rf /)",
      "Bash(rm -rf ~)",
      "Bash(rm -rf .)",
      "Bash(sudo *)",
      "Bash(chmod 777 *)",
      "Bash(> /dev/sda*)",
      "Bash(dd if=*)",
      "Bash(mkfs.*)",
      "Bash(curl * | sh)",
      "Bash(wget * -O- | sh)",
      "Edit(/etc/**)",
      "Edit(/bin/**)",
      "Edit(/boot/**)",
      "Edit(/dev/**)",
      "Edit(/sys/**)",
      "Edit(/proc/**)",
      "Edit(/root/**)",
      "Edit(~/.ssh/**)",
      "Edit(~/.gnupg/**)"
    ],
    "defaultMode": "auto"
  },
  "enabledPlugins": {
    "clangd-lsp@claude-plugins-official": true
  },
  "theme": "dark",
  "skipWorkflowUsageWarning": true,
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cfp hook --platform=claude"
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cfp hook --platform=claude"
          }
        ],
        "matcher": "Bash|PowerShell|Edit|MultiEdit|Write|NotebookEdit"
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cfp hook --platform=claude"
          }
        ],
        "matcher": "AskUserQuestion"
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash /root/.claude/hooks/user-prompt-handler.sh",
            "timeout": 5000
          }
        ]
      }
    ]
  }
}
